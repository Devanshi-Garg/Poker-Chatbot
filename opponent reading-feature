<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Poker Mind - Texas Hold'em Monte Carlo & Gemini AI Advisor</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        pokerGreen: {
                            800: '#0c3823',
                            700: '#14532d',
                            600: '#15803d',
                            500: '#22c55e',
                        },
                        felt: '#0f3d24',
                        feltBorder: '#3f2d1d',
                        gold: {
                            400: '#fbbf24',
                            500: '#f59e0b',
                            600: '#d97706',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #0b0f19;
            color: #f3f4f6;
            font-family: 'Inter', sans-serif;
        }
        .poker-felt {
            background: radial-gradient(ellipse at center, #1b5e32 0%, #0d381e 70%, #072011 100%);
            box-shadow: inset 0 0 80px rgba(0,0,0,0.8), 0 0 20px rgba(0,0,0,0.5);
            border: 12px solid #3d2612;
        }
        .card {
            transition: all 0.2s ease;
            user-select: none;
        }
        .card:hover {
            transform: translateY(-4px);
        }
        .suit-heart, .suit-diamond { color: #ef4444; }
        .suit-club, .suit-spade { color: #1e293b; }
        
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #111827;
        }
        ::-webkit-scrollbar-thumb {
            background: #374151;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #4b5563;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between bg-slate-950 text-slate-100 overflow-x-hidden">

    <!-- Top Header -->
    <header class="border-b border-slate-800 bg-slate-900/90 backdrop-blur sticky top-0 z-30 px-4 py-3">
        <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-3">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-600 to-green-400 flex items-center justify-center text-slate-950 font-black text-xl shadow-lg shadow-emerald-900/40">
                    ♠
                </div>
                <div>
                    <h1 class="text-xl font-bold tracking-tight bg-gradient-to-r from-emerald-400 via-green-200 to-amber-300 bg-clip-text text-transparent">
                        PokerMind AI
                    </h1>
                    <p class="text-xs text-slate-400">Monte Carlo Engine & Gemini Coach</p>
                </div>
            </div>

            <!-- Action Buttons / Key Setup -->
            <div class="flex items-center gap-2">
                <button onclick="toggleKeyModal()" id="apiKeyStatusBtn" class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800 hover:bg-slate-700 text-xs font-medium flex items-center gap-2 transition">
                    <span id="apiKeyDot" class="w-2 h-2 rounded-full bg-amber-500"></span>
                    <span id="apiKeyText">Set Gemini API Key</span>
                </button>
                <button onclick="openGuideModal()" class="px-3 py-1.5 rounded-lg bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-400 border border-emerald-500/30 text-xs font-semibold flex items-center gap-1.5 transition">
                    <i class="fa-solid fa-book-open">poker</i> Strategy Cheat Sheet
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content Grid -->
    <main class="max-w-7xl w-full mx-auto p-4 md:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 flex-grow">
        
        <!-- Left Panel: Table, Controls & Calculator (7 Cols) -->
        <section class="lg:col-span-7 flex flex-col gap-6">
            
            <!-- Quick Preset Scenarios -->
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4">
                <div class="flex justify-between items-center mb-3">
                    <h2 class="text-xs uppercase tracking-wider font-bold text-slate-400 flex items-center gap-2">
                        <i class="fa-solid fa-bolt text-amber-400"></i> Practice Preset Scenarios
                    </h2>
                    <span class="text-xs text-slate-500">Quick load hands</span>
                </div>
                <div class="flex flex-wrap gap-2">
                    <button onclick="loadPreset('pocket_aces')" class="px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 rounded-lg text-xs font-medium text-slate-300 border border-slate-700/60 transition">
                        🔥 Pocket Aces (Preflop)
                    </button>
                    <button onclick="loadPreset('flush_draw')" class="px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 rounded-lg text-xs font-medium text-slate-300 border border-slate-700/60 transition">
                        🌊 Nut Flush Draw (Flop)
                    </button>
                    <button onclick="loadPreset('set_flop')" class="px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 rounded-lg text-xs font-medium text-slate-300 border border-slate-700/60 transition">
                        💣 Three of a Kind (Flop)
                    </button>
                    <button onclick="loadPreset('bluff_river')" class="px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 rounded-lg text-xs font-medium text-slate-300 border border-slate-700/60 transition">
                        🎭 Missed Straight (River)
                    </button>
                </div>
            </div>

            <!-- Poker Felt Visual Table -->
            <div class="poker-felt rounded-3xl p-6 md:p-8 flex flex-col items-center justify-between min-h-[360px] relative overflow-hidden">
                
                <!-- Community Cards Area -->
                <div class="text-center w-full z-10">
                    <span class="text-xs font-bold uppercase tracking-widest text-emerald-200/60 mb-2 block">
                        Community Board (Flop / Turn / River)
                    </span>
                    <div class="flex justify-center items-center gap-2 md:gap-3 my-2">
                        <!-- 5 Board Card Slots -->
                        <div onclick="openCardPicker('board', 0)" id="board-0" class="card w-14 h-20 md:w-16 md:h-24 bg-slate-900/80 border-2 border-dashed border-emerald-500/40 rounded-xl flex flex-col items-center justify-center cursor-pointer hover:border-amber-400">
                            <span class="text-xs text-emerald-400/60">Flop 1</span>
                        </div>
                        <div onclick="openCardPicker('board', 1)" id="board-1" class="card w-14 h-20 md:w-16 md:h-24 bg-slate-900/80 border-2 border-dashed border-emerald-500/40 rounded-xl flex flex-col items-center justify-center cursor-pointer hover:border-amber-400">
                            <span class="text-xs text-emerald-400/60">Flop 2</span>
                        </div>
                        <div onclick="openCardPicker('board', 2)" id="board-2" class="card w-14 h-20 md:w-16 md:h-24 bg-slate-900/80 border-2 border-dashed border-emerald-500/40 rounded-xl flex flex-col items-center justify-center cursor-pointer hover:border-amber-400">
                            <span class="text-xs text-emerald-400/60">Flop 3</span>
                        </div>
                        <div onclick="openCardPicker('board', 3)" id="board-3" class="card w-14 h-20 md:w-16 md:h-24 bg-slate-900/80 border-2 border-dashed border-emerald-500/40 rounded-xl flex flex-col items-center justify-center cursor-pointer hover:border-amber-400">
                            <span class="text-xs text-emerald-400/60">Turn</span>
                        </div>
                        <div onclick="openCardPicker('board', 4)" id="board-4" class="card w-14 h-20 md:w-16 md:h-24 bg-slate-900/80 border-2 border-dashed border-emerald-500/40 rounded-xl flex flex-col items-center justify-center cursor-pointer hover:border-amber-400">
                            <span class="text-xs text-emerald-400/60">River</span>
                        </div>
                    </div>
                </div>

                <!-- Pot Display Center Badge -->
                <div class="my-4 bg-slate-950/80 border border-amber-500/40 px-6 py-2 rounded-full backdrop-blur text-center shadow-lg z-10">
                    <span class="text-xs uppercase text-slate-400 tracking-wider font-semibold">Total Pot</span>
                    <div class="text-amber-400 font-extrabold text-xl font-mono" id="tablePotDisplay">$150</div>
                </div>

                <!-- Hole Cards Player Area -->
                <div class="text-center w-full z-10">
                    <span class="text-xs font-bold uppercase tracking-widest text-emerald-200/80 mb-2 block">
                        Your Hole Cards (Hand)
                    </span>
                    <div class="flex justify-center items-center gap-3">
                        <div onclick="openCardPicker('hole', 0)" id="hole-0" class="card w-16 h-24 md:w-20 md:h-28 bg-slate-900/90 border-2 border-dashed border-emerald-400/60 rounded-xl flex flex-col items-center justify-center cursor-pointer hover:border-amber-400 shadow-xl">
                            <span class="text-xs text-emerald-300/80 font-medium">Card 1</span>
                        </div>
                        <div onclick="openCardPicker('hole', 1)" id="hole-1" class="card w-16 h-24 md:w-20 md:h-28 bg-slate-900/90 border-2 border-dashed border-emerald-400/60 rounded-xl flex flex-col items-center justify-center cursor-pointer hover:border-amber-400 shadow-xl">
                            <span class="text-xs text-emerald-300/80 font-medium">Card 2</span>
                        </div>
                    </div>
                </div>

                <!-- Table Clear Button -->
                <button onclick="clearTableCards()" class="absolute bottom-3 right-3 text-xs text-emerald-200/50 hover:text-emerald-200 bg-slate-950/50 hover:bg-slate-900 px-3 py-1.5 rounded-lg border border-emerald-500/20 transition">
                    <i class="fa-solid fa-rotate-left mr-1"></i> Clear Cards
                </button>
            </div>

            <!-- Input Parameters & Run Button -->
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                    <label class="text-xs font-semibold text-slate-400 block mb-1">
                        Active Opponents (<span id="opponentsVal">2</span>)
                    </label>
                    <input type="range" min="1" max="8" value="2" id="opponentsInput" oninput="updateOpponents(this.value)" class="w-full accent-emerald-500 cursor-pointer">
                    <div class="flex justify-between text-[10px] text-slate-500 mt-1">
                        <span>1 Heads up</span>
                        <span>4 Medium</span>
                        <span>8 Full Ring</span>
                    </div>
                </div>

                <div>
                    <label class="text-xs font-semibold text-slate-400 block mb-1">Current Pot Size ($)</label>
                    <div class="relative">
                        <span class="absolute left-3 top-2 text-slate-500 font-mono text-sm">$</span>
                        <input type="number" id="potInput" value="150" min="0" oninput="updatePot(this.value)" class="w-full bg-slate-800 border border-slate-700 rounded-xl py-1.5 pl-7 pr-3 font-mono text-sm text-slate-100 focus:outline-none focus:border-emerald-500">
                    </div>
                </div>

                <div>
                    <label class="text-xs font-semibold text-slate-400 block mb-1">To Call / Raise Amount ($)</label>
                    <div class="relative">
                        <span class="absolute left-3 top-2 text-slate-500 font-mono text-sm">$</span>
                        <input type="number" id="callInput" value="50" min="0" oninput="updateCall(this.value)" class="w-full bg-slate-800 border border-slate-700 rounded-xl py-1.5 pl-7 pr-3 font-mono text-sm text-slate-100 focus:outline-none focus:border-emerald-500">
                    </div>
                </div>

                <div class="sm:col-span-3 mt-2">
                    <button id="runSimBtn" onclick="runMonteCarloSimulation()" class="w-full py-3.5 bg-gradient-to-r from-emerald-600 to-green-500 hover:from-emerald-500 hover:to-green-400 text-slate-950 font-extrabold rounded-xl shadow-lg shadow-emerald-900/30 flex items-center justify-center gap-2 transition text-base">
                        <i class="fa-solid fa-calculator"></i> Run Monte Carlo Simulation (10,000 Hands)
                    </button>
                </div>
            </div>

            <!-- Monte Carlo Results Box -->
            <div id="simResultsCard" class="bg-slate-900 border border-slate-800 rounded-2xl p-5 hidden">
                <div class="flex justify-between items-center mb-4 pb-3 border-b border-slate-800">
                    <div>
                        <h3 class="font-bold text-sm text-slate-200">Monte Carlo Equity Report</h3>
                        <p id="simSubtitle" class="text-xs text-slate-400">Simulated 10,000 random card deals</p>
                    </div>
                    <div id="recommendedBadge" class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                        RAISE / BET
                    </div>
                </div>

                <!-- Core Metrics Grid -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
                    <div class="bg-slate-950 p-3 rounded-xl border border-slate-800/80">
                        <span class="text-[10px] uppercase font-bold text-slate-500 block">Win Equity</span>
                        <span id="winRateVal" class="text-xl font-black text-emerald-400 font-mono">0.0%</span>
                    </div>
                    <div class="bg-slate-950 p-3 rounded-xl border border-slate-800/80">
                        <span class="text-[10px] uppercase font-bold text-slate-500 block">Tie %</span>
                        <span id="tieRateVal" class="text-xl font-black text-amber-400 font-mono">0.0%</span>
                    </div>
                    <div class="bg-slate-950 p-3 rounded-xl border border-slate-800/80">
                        <span class="text-[10px] uppercase font-bold text-slate-500 block">Pot Odds</span>
                        <span id="potOddsVal" class="text-xl font-black text-indigo-400 font-mono">0.0%</span>
                    </div>
                    <div class="bg-slate-950 p-3 rounded-xl border border-slate-800/80">
                        <span class="text-[10px] uppercase font-bold text-slate-500 block">Expected Value (EV)</span>
                        <span id="evVal" class="text-xl font-black text-emerald-400 font-mono">+$0.00</span>
                    </div>
                </div>

                <!-- Visual Bar Breakdown -->
                <div class="space-y-2">
                    <div class="flex justify-between text-xs text-slate-400">
                        <span>Outcome Distribution</span>
                        <span id="equityBreakdownLabel">Win: 0% | Tie: 0% | Loss: 0%</span>
                    </div>
                    <div class="h-3 w-full bg-slate-950 rounded-full overflow-hidden flex">
                        <div id="winBar" class="bg-emerald-500 h-full transition-all duration-500" style="width: 0%"></div>
                        <div id="tieBar" class="bg-amber-400 h-full transition-all duration-500" style="width: 0%"></div>
                        <div id="lossBar" class="bg-rose-500 h-full transition-all duration-500" style="width: 0%"></div>
                    </div>
                </div>

                <div class="mt-4 p-3 bg-slate-950/60 rounded-xl border border-slate-800 text-xs text-slate-300 leading-relaxed" id="simAnalysisText">
                    Run simulation to view mathematical decision analysis.
                </div>
            </div>

            <!-- Opponent Reads: tracks each opponent's likely hands from their actions -->
            <div id="readsCard" class="bg-slate-900 border border-slate-800 rounded-2xl p-5">
                <div class="flex justify-between items-start gap-3 mb-3">
                    <div>
                        <h3 class="font-bold text-sm text-slate-200 flex items-center gap-2">
                            <i class="fa-solid fa-user-secret text-amber-400"></i> Opponent Reads
                        </h3>
                        <p class="text-xs text-slate-400">Log what each opponent does. Their likely hands narrow and your equity updates live.</p>
                    </div>
                    <button onclick="resetReads()" class="shrink-0 text-xs text-slate-400 hover:text-slate-200 px-2 py-1 rounded hover:bg-slate-800 transition">
                        <i class="fa-solid fa-rotate-left mr-1"></i> New Hand
                    </button>
                </div>

                <!-- Opponent Tabs -->
                <div id="oppTabs" class="flex flex-wrap gap-1.5 mb-3"></div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
                    <div>
                        <label class="text-xs font-semibold text-slate-400 block mb-1">Player Type</label>
                        <select id="oppTypeSelect" onchange="setOpponentType(this.value)" class="w-full bg-slate-800 border border-slate-700 rounded-xl py-1.5 px-3 text-xs text-slate-100 focus:outline-none focus:border-emerald-500"></select>
                    </div>
                    <div>
                        <label class="text-xs font-semibold text-slate-400 block mb-1">Their Bet / Call Amount ($)</label>
                        <div class="relative">
                            <span class="absolute left-3 top-1.5 text-slate-500 font-mono text-sm">$</span>
                            <input type="number" id="oppBetInput" value="50" min="0" class="w-full bg-slate-800 border border-slate-700 rounded-xl py-1.5 pl-7 pr-3 font-mono text-sm text-slate-100 focus:outline-none focus:border-emerald-500">
                        </div>
                    </div>
                </div>

                <div class="flex justify-between items-center text-[11px] text-slate-400 mb-2">
                    <span>Street: <b id="streetLabel" class="text-slate-200">Preflop</b></span>
                    <button onclick="undoOpponentAction()" class="text-slate-400 hover:text-slate-200"><i class="fa-solid fa-arrow-rotate-left mr-1"></i>Undo last</button>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-3">
                    <button onclick="logOpponentAction('check')" class="py-2 rounded-xl text-xs font-bold bg-blue-500/15 text-blue-300 border border-blue-500/30 hover:bg-blue-500/25 transition">Check</button>
                    <button onclick="logOpponentAction('call')" class="py-2 rounded-xl text-xs font-bold bg-amber-500/15 text-amber-300 border border-amber-500/30 hover:bg-amber-500/25 transition">Call</button>
                    <button onclick="logOpponentAction('raise')" class="py-2 rounded-xl text-xs font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 hover:bg-emerald-500/25 transition">Bet / Raise</button>
                    <button onclick="logOpponentAction('fold')" class="py-2 rounded-xl text-xs font-bold bg-rose-500/15 text-rose-300 border border-rose-500/30 hover:bg-rose-500/25 transition">Fold</button>
                </div>

                <div id="readsUpdate" class="hidden mb-3 p-2.5 rounded-xl border border-amber-500/30 bg-amber-500/10 text-xs text-amber-100"></div>

                <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
                    <div class="md:col-span-3">
                        <div class="flex justify-between text-[10px] uppercase font-bold text-slate-500 mb-1.5">
                            <span>Likely Hands</span>
                            <span id="rangeWidthLabel" class="normal-case font-semibold">Any hand possible</span>
                        </div>
                        <div id="rangeGrid" class="grid gap-px bg-slate-950 rounded-lg overflow-hidden" style="grid-template-columns: repeat(13, minmax(0, 1fr));"></div>
                    </div>
                    <div class="md:col-span-2 space-y-3">
                        <div>
                            <span class="text-[10px] uppercase font-bold text-slate-500 block mb-1.5">Most Likely Holdings</span>
                            <div id="topHands" class="flex flex-wrap gap-1.5 text-xs text-slate-400">No reads yet</div>
                        </div>
                        <div>
                            <span class="text-[10px] uppercase font-bold text-slate-500 block mb-1.5">Action Log</span>
                            <div id="actionLog" class="space-y-1 max-h-40 overflow-y-auto text-xs text-slate-300"></div>
                        </div>
                    </div>
                </div>
            </div>

        </section>

        <!-- Right Panel: Gemini AI Chat Advisor (5 Cols) -->
        <section class="lg:col-span-5 flex flex-col h-[650px] lg:h-auto bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
            
            <!-- Chat Header -->
            <div class="bg-slate-800/80 border-b border-slate-700/60 p-3.5 flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center font-bold text-sm">
                        <i class="fa-solid fa-robot"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-slate-100">Gemini Poker Coach</h3>
                        <p class="text-[10px] text-emerald-400 flex items-center gap-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Context-Aware Assistant
                        </p>
                    </div>
                </div>
                <button onclick="clearChatHistory()" class="text-xs text-slate-400 hover:text-slate-200 px-2 py-1 rounded hover:bg-slate-700/50 transition">
                    Clear Chat
                </button>
            </div>

            <!-- Chat Message List -->
            <div id="chatMessages" class="flex-grow p-4 overflow-y-auto space-y-3 font-sans text-sm">
                <!-- Welcome Bot Message -->
                <div class="flex items-start gap-2.5">
                    <div class="w-7 h-7 rounded-full bg-emerald-600/30 text-emerald-400 border border-emerald-500/30 flex items-center justify-center text-xs shrink-0 mt-0.5">
                        <i class="fa-solid fa-robot"></i>
                    </div>
                    <div class="bg-slate-800 border border-slate-700/70 p-3 rounded-2xl rounded-tl-xs text-slate-300 max-w-[85%] text-xs leading-relaxed">
                        Welcome! I'm your Gemini Texas Hold'em AI Coach. Select your 2 hole cards and any community board cards on the table, then run the Monte Carlo simulation. 
                        <br><br>
                        Once simulated, ask me anything! E.g. <i>"Should I re-raise or just call?"</i> or <i>"Explain pot odds to me like I'm 10."</i>
                    </div>
                </div>
            </div>

            <!-- Quick AI Prompt Suggestions -->
            <div class="px-3 py-2 bg-slate-950/60 border-t border-slate-800 flex gap-2 overflow-x-auto text-[11px] no-scrollbar">
                <button onclick="sendQuickPrompt('Explain why the Monte Carlo calculation recommends this action.')" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg whitespace-nowrap border border-slate-700">
                    💡 Explain recommendation
                </button>
                <button onclick="sendQuickPrompt('What if my opponent goes all-in?')" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg whitespace-nowrap border border-slate-700">
                    ⚔️ What if they call/re-raise?
                </button>
                <button onclick="sendQuickPrompt('How does my table position affect this decision?')" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg whitespace-nowrap border border-slate-700">
                    📍 Position Advice
                </button>
                <button onclick="sendQuickPrompt('Based on how my opponents have acted, what hands are they likely holding, and how should that change my play?')" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg whitespace-nowrap border border-slate-700">
                    🕵️ Read my opponents
                </button>
            </div>

            <!-- Chat Input Form -->
            <form onsubmit="handleChatSubmit(event)" class="p-3 bg-slate-950 border-t border-slate-800 flex gap-2">
                <input type="text" id="chatInput" placeholder="Ask Gemini strategy question..." class="flex-grow bg-slate-800 border border-slate-700 rounded-xl px-3.5 py-2 text-xs text-slate-100 focus:outline-none focus:border-emerald-500 placeholder-slate-500">
                <button type="submit" id="sendBtn" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-slate-950 font-bold rounded-xl text-xs transition flex items-center gap-1.5 shrink-0">
                    <span>Send</span>
                    <i class="fa-solid fa-paper-plane text-[10px]"></i>
                </button>
            </form>
        </section>

    </main>

    <!-- Card Picker Modal -->
