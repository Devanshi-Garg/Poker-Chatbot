                    <div class="text-xs font-black text-right leading-none ${isRed ? 'text-red-600' : 'text-slate-900'}">${card.r}</div>
                </div>
            `;
        }

        function renderTable() {
            // Render hole cards
            for (let i = 0; i < 2; i++) {
                const el = document.getElementById(`hole-${i}`);
                const card = gameState.hole[i];
                if (card) {
                    el.className = "card w-16 h-24 md:w-20 md:h-28 bg-white rounded-xl p-0.5 cursor-pointer shadow-xl border-2 border-emerald-400";
                    el.innerHTML = createCardElement(card, `Card ${i+1}`);
                } else {
                    el.className = "card w-16 h-24 md:w-20 md:h-28 bg-slate-900/90 border-2 border-dashed border-emerald-400/60 rounded-xl flex flex-col items-center justify-center cursor-pointer hover:border-amber-400 shadow-xl";
                    el.innerHTML = `<span class="text-xs text-emerald-300/80 font-medium">Card ${i+1}</span>`;
                }
            }

            // Render board cards
            const boardNames = ['Flop 1', 'Flop 2', 'Flop 3', 'Turn', 'River'];
            for (let i = 0; i < 5; i++) {
                const el = document.getElementById(`board-${i}`);
                const card = gameState.board[i];
                if (card) {
                    el.className = "card w-14 h-20 md:w-16 md:h-24 bg-white rounded-xl p-0.5 cursor-pointer shadow-md border-2 border-emerald-400";
                    el.innerHTML = createCardElement(card, boardNames[i]);
                } else {
                    el.className = "card w-14 h-20 md:w-16 md:h-24 bg-slate-900/80 border-2 border-dashed border-emerald-500/40 rounded-xl flex flex-col items-center justify-center cursor-pointer hover:border-amber-400";
                    el.innerHTML = `<span class="text-xs text-emerald-400/60">${boardNames[i]}</span>`;
                }
            }

            // Street and blocked hands in Opponent Reads depend on the cards shown
            renderReads();
        }

        // 7-Card Hand Evaluation Logic
        function evaluate7CardHand(cards) {
            // Convert cards to numeric values
            const parsed = cards.map(c => ({ r: RANK_VALUES[c.r], s: c.s }));
            
            // Generate all 21 combinations of 5 cards out of 7
            let bestScore = -1;
            const len = parsed.length;

            for (let a = 0; a < len - 4; a++) {
                for (let b = a + 1; b < len - 3; b++) {
                    for (let c = b + 1; c < len - 2; c++) {
                        for (let d = c + 1; d < len - 1; d++) {
                            for (let e = d + 1; e < len; e++) {
                                const combo = [parsed[a], parsed[b], parsed[c], parsed[d], parsed[e]];
                                const score = score5CardHand(combo);
                                if (score > bestScore) bestScore = score;
                            }
                        }
                    }
                }
            }
            return bestScore;
        }

        // Returns a unique integer score for comparing 5-card hands
        function score5CardHand(hand) {
            hand.sort((a, b) => b.r - a.r); // Sort descending
            const ranks = hand.map(c => c.r);
            const suits = hand.map(c => c.s);

            const isFlush = suits.every(s => s === suits[0]);
            
            // Check Straight
            let isStraight = false;
            let straightHigh = 0;
            if (ranks[0] - ranks[4] === 4 && new Set(ranks).size === 5) {
                isStraight = true;
                straightHigh = ranks[0];
            } else if (ranks[0] === 14 && ranks[1] === 5 && ranks[2] === 4 && ranks[3] === 3 && ranks[4] === 2) {
                // Ace-low straight (A-2-3-4-5)
                isStraight = true;
                straightHigh = 5;
            }

            // Rank counts
            const counts = {};
            ranks.forEach(r => counts[r] = (counts[r] || 0) + 1);
            const countPairs = Object.entries(counts).map(([r, count]) => ({ r: Number(r), count }));
            countPairs.sort((a, b) => b.count - a.count || b.r - a.r);

            // Hand Categories (Base Multipliers)
            // 8: Straight Flush, 7: 4 of a kind, 6: Full House, 5: Flush, 4: Straight, 3: 3 of a kind, 2: Two Pair, 1: Pair, 0: High Card
            let category = 0;

            if (isStraight && isFlush) category = 8;
            else if (countPairs[0].count === 4) category = 7;
            else if (countPairs[0].count === 3 && countPairs[1].count === 2) category = 6;
            else if (isFlush) category = 5;
            else if (isStraight) category = 4;
            else if (countPairs[0].count === 3) category = 3;
            else if (countPairs[0].count === 2 && countPairs[1].count === 2) category = 2;
            else if (countPairs[0].count === 2) category = 1;
            else category = 0;

            // Construct bitwise score integer for instant fast comparisons
            let score = category * 1000000;
            if (category === 8 || category === 4) {
                score += straightHigh;
            } else {
                let tiebreaker = 0;
                countPairs.forEach((cp, idx) => {
                    tiebreaker += cp.r * Math.pow(15, 4 - idx);
                });
                score += tiebreaker;
            }
            return score;
        }

        // ==========================================
        // OPPONENT READS: BAYESIAN RANGE TRACKING
        // ==========================================
        // Each opponent has a weight for all 1326 possible hole-card combos.
        // Every logged action multiplies each combo's weight by how likely that
        // hand is to take that action (Bayes' rule). The Monte Carlo then deals
        // opponents hands drawn from these weights instead of uniformly at random.

        // Card index 0-51 = rankIndex * 4 + suitIndex
        const CARD_OBJS = [];
        RANKS.forEach(r => SUITS.forEach(s => CARD_OBJS.push({ r, s })));
        const cardIndex = c => RANKS.indexOf(c.r) * 4 + SUITS.indexOf(c.s);

        const ALL_COMBOS = [];
        for (let a = 0; a < 52; a++) {
            for (let b = a + 1; b < 52; b++) ALL_COMBOS.push([a, b]);
        }
        const NUM_COMBOS = ALL_COMBOS.length; // 1326

        // e.g. "AKs", "T9o", "77"
        const COMBO_CLASS = ALL_COMBOS.map(([a, b]) => {
            const hi = Math.max(a >> 2, b >> 2), lo = Math.min(a >> 2, b >> 2);
            if (hi === lo) return RANKS[hi] + RANKS[lo];
            return RANKS[hi] + RANKS[lo] + ((a & 3) === (b & 3) ? 's' : 'o');
        });

        // How each player type plays:
        // vpip = share of hands played preflop, pfr = share raised preflop,
        // betFreq = share of their range that bets a half-pot after the flop,
        // bluff = chance a weak hand bets/raises anyway
        const PLAYER_TYPES = {
            average: { label: 'Average Player', vpip: 0.30, pfr: 0.15, betFreq: 0.40, bluff: 0.03 },
            rock:    { label: 'Tight & Careful (Rock)', vpip: 0.15, pfr: 0.08, betFreq: 0.30, bluff: 0.01 },
            station: { label: 'Calls Everything (Station)', vpip: 0.60, pfr: 0.06, betFreq: 0.25, bluff: 0.02 },
            maniac:  { label: 'Loose & Aggressive (Maniac)', vpip: 0.55, pfr: 0.35, betFreq: 0.65, bluff: 0.12 }
        };

        const STREET_NAMES = { 0: 'Preflop', 3: 'Flop', 4: 'Turn', 5: 'River' };

        let opponentReads = createOpponentReads();
        let selectedOpp = 0;
        let baselineCache = { key: null, equity: null };

        function createOpponentReads(types = []) {
            return Array.from({ length: 8 }, (_, i) => ({
                type: types[i] || 'average',
                actions: [],
                folded: false,
                weights: new Float64Array(NUM_COMBOS).fill(1)
            }));
        }

        function getActiveOpponents() {
            return opponentReads.slice(0, gameState.opponents).filter(o => !o.folded);
        }

        // Chen formula: quick preflop hand score (about -1 to 20)
        function chenScore(a, b) {
            const r1 = Math.max(a >> 2, b >> 2) + 2, r2 = Math.min(a >> 2, b >> 2) + 2;
            const high = { 14: 10, 13: 8, 12: 7, 11: 6 }[r1] ?? r1 / 2;
            if (r1 === r2) return Math.max(high * 2, 5);
            let score = high;
            if ((a & 3) === (b & 3)) score += 2;
            const gap = r1 - r2 - 1;
            score -= gap < 4 ? [0, 1, 2, 4][gap] : 5;
            if (gap <= 1 && r1 < 12) score += 1;
            return score;
        }

        // Raw hand strength of every combo on a board (NaN = blocked by the board)
        const rawStrengthCache = {};
        function rawStrengths(boardIdx) {
            const key = boardIdx.join(',');
            if (rawStrengthCache[key]) return rawStrengthCache[key];
            const raw = new Float64Array(NUM_COMBOS).fill(NaN);
            const boardCards = boardIdx.map(i => CARD_OBJS[i]);
            ALL_COMBOS.forEach(([a, b], k) => {
                if (boardIdx.includes(a) || boardIdx.includes(b)) return;
                raw[k] = boardIdx.length
                    ? evaluate7CardHand([CARD_OBJS[a], CARD_OBJS[b], ...boardCards])
                    : chenScore(a, b);
            });
            return (rawStrengthCache[key] = raw);
        }

        // Percentile of each combo inside the opponent's current range (1 = their best hand).
        // Ranking within the range is what makes "they raise their top 15%" mean the
        // right thing after earlier actions already narrowed it.
        function rangePercentiles(raw, weights) {
            const live = [];
            for (let k = 0; k < NUM_COMBOS; k++) {
                if (!Number.isNaN(raw[k]) && weights[k] > 0) live.push(k);
            }
            live.sort((x, y) => raw[x] - raw[y]);
            const total = live.reduce((sum, k) => sum + weights[k], 0);
            const pct = new Float64Array(NUM_COMBOS).fill(NaN);
            let below = 0;
            for (let i = 0; i < live.length;) {
                let j = i, w = 0;
                while (j < live.length && raw[live[j]] === raw[live[i]]) w += weights[live[j++]];
                for (let m = i; m < j; m++) pct[live[m]] = (below + w / 2) / total; // tied hands share a percentile
                below += w;
                i = j;
            }
            return pct;
        }

        const sigmoid = x => 1 / (1 + Math.exp(-x));

        // P(action | hand at percentile s of their range). betFrac = bet / pot.
        function actionLikelihood(s, action, betFrac, preflop, p) {
            const steep = 40;
            let tCall, tRaise;
            if (preflop) {
                tCall = 1 - p.vpip;
                tRaise = 1 - p.pfr;
            } else {
                // Bigger bets called = stronger hands; loose players call wider
                tCall = Math.min(0.95, Math.max(0.05, 0.4 + 0.1 * Math.min(betFrac, 3) - (p.vpip - 0.30)));
                // Bigger bets = narrower range
                tRaise = 1 - p.betFreq / (1 + betFrac);
            }
            const pStrong = sigmoid(steep * (s - tRaise));
            let prob;
            if (action === 'raise') prob = p.bluff + (1 - p.bluff) * pStrong;
            else if (action === 'call') prob = sigmoid(steep * (s - tCall)) * (1 - 0.6 * pStrong);
            else if (action === 'check') prob = 1 - 0.7 * pStrong; // strong hands mostly bet, sometimes trap
            else prob = 1;
            return Math.max(prob, 0.01); // never rule a hand out completely
        }

        // Replay an opponent's action log from scratch (so changing player type re-reads everything)
        function recomputeRange(opp) {
            const w = new Float64Array(NUM_COMBOS).fill(1);
            const profile = PLAYER_TYPES[opp.type];
            for (const act of opp.actions) {
                if (act.action === 'fold') continue;
                const pct = rangePercentiles(rawStrengths(act.board), w);
                let total = 0;
                for (let k = 0; k < NUM_COMBOS; k++) {
                    w[k] = Number.isNaN(pct[k])
                        ? 0
                        : w[k] * actionLikelihood(pct[k], act.action, act.betFrac, act.board.length === 0, profile);
                    total += w[k];
                }
                for (let k = 0; k < NUM_COMBOS; k++) w[k] /= total;
            }
            opp.weights = w;
        }

        // Cumulative weights over combos that don't use known cards
        function buildRangeSampler(weights, known) {
            const combos = [], cum = [];
            let total = 0;
            for (let k = 0; k < NUM_COMBOS; k++) {
                const [a, b] = ALL_COMBOS[k];
                if (weights[k] > 0 && !known.has(a) && !known.has(b)) {
                    total += weights[k];
                    combos.push(k);
                    cum.push(total);
                }
            }
            return { combos, cum, total };
        }

        function sampleRange(sampler) {
            const x = Math.random() * sampler.total;
            let lo = 0, hi = sampler.cum.length - 1;
            while (lo < hi) {
                const mid = (lo + hi) >> 1;
                if (sampler.cum[mid] < x) lo = mid + 1; else hi = mid;
            }
            return sampler.combos[lo];
        }

        // Monte Carlo core. Opponents' hole cards come from their read ranges
        // (uniform when nothing is logged, which matches a plain random deal).
        function simulateEquity(iterations, oppWeights) {
            const activeBoardCards = gameState.board.filter(Boolean);
            const known = new Set([...gameState.hole, ...activeBoardCards].map(cardIndex));
            const deck = [];
            for (let c = 0; c < 52; c++) if (!known.has(c)) deck.push(c);
            const samplers = oppWeights.map(w => buildRangeSampler(w, known));
            const usedIn = new Int32Array(52).fill(-1); // iteration number a card was dealt in
            let wins = 0, ties = 0, losses = 0;

            for (let i = 0; i < iterations; i++) {
                // Deal each opponent a hand from their range, avoiding cards already dealt this round
                const oppHoles = [];
                for (const sampler of samplers) {
                    let combo = null;
                    for (let tries = 0; tries < 25 && !combo && sampler.total > 0; tries++) {
                        const [a, b] = ALL_COMBOS[sampleRange(sampler)];
                        if (usedIn[a] !== i && usedIn[b] !== i) combo = [a, b];
                    }
                    if (!combo) {
                        const free = deck.filter(c => usedIn[c] !== i);
                        const x = free.splice(Math.floor(Math.random() * free.length), 1)[0];
                        combo = [x, free[Math.floor(Math.random() * free.length)]];
                    }
                    usedIn[combo[0]] = usedIn[combo[1]] = i;
                    oppHoles.push(combo.map(c => CARD_OBJS[c]));
                }

                // Deal the rest of the board from what's left
                const simBoard = activeBoardCards.slice();
                const remaining = deck.slice();
                let n = remaining.length;
                while (simBoard.length < 5) {
                    const k = Math.floor(Math.random() * n);
                    const c = remaining[k];
                    remaining[k] = remaining[--n];
                    if (usedIn[c] !== i) simBoard.push(CARD_OBJS[c]);
                }

                const playerScore = evaluate7CardHand([...gameState.hole, ...simBoard]);
                let bestOpponentScore = -1;
                for (const hole of oppHoles) {
                    const oppScore = evaluate7CardHand([...hole, ...simBoard]);
                    if (oppScore > bestOpponentScore) bestOpponentScore = oppScore;
                }

                if (playerScore > bestOpponentScore) wins++;
                else if (playerScore === bestOpponentScore) ties++;
                else losses++;
            }
            return { wins, ties, losses };
        }

        function tableKey(activeCount) {
            return [...gameState.hole, ...gameState.board].map(c => c ? c.r + c.s : '-').join('') + '|' + activeCount;
        }

        // Equity vs random hands, for "your reads moved equity from X to Y"
        function baselineEquity(activeCount) {
            const key = tableKey(activeCount);
            if (baselineCache.key !== key) {
                const iterations = 3000;
                const uniform = new Float64Array(NUM_COMBOS).fill(1);
                const r = simulateEquity(iterations, Array(activeCount).fill(uniform));
                baselineCache = { key, equity: (r.wins + r.ties / 2) / iterations * 100 };
            }
            return baselineCache.equity;
        }

        // Share of each hand class in the range, effective width, and the top classes
        function summarizeRange(opp) {
            const dead = new Set([...gameState.hole, ...gameState.board].filter(Boolean).map(cardIndex));
            const classes = {};
            let total = 0;
            ALL_COMBOS.forEach(([a, b], k) => {
                if (dead.has(a) || dead.has(b)) return;
                const c = classes[COMBO_CLASS[k]] ||= { weight: 0, combos: 0 };
                c.weight += opp.weights[k];
                c.combos++;
                total += opp.weights[k];
            });
            // Effective width = exp(entropy) / possible combos (100% = any hand)
            let entropy = 0, live = 0;
            ALL_COMBOS.forEach(([a, b], k) => {
                if (dead.has(a) || dead.has(b)) return;
                live++;
                const p = opp.weights[k] / total;
                if (p > 0) entropy -= p * Math.log(p);
            });
            const top = Object.entries(classes)
                .sort((x, y) => y[1].weight - x[1].weight)
                .slice(0, 6)
                .map(([label, c]) => ({ label, share: c.weight / total * 100 }));
            return { classes, widthPct: Math.exp(entropy) / live * 100, top };
        }

        function describeAction(a) {
            if (a.action === 'raise') return `bet/raised $${a.amount} (${a.betFrac.toFixed(1)}x pot)`;
            if (a.action === 'call') return `called $${a.amount}`;
            return a.action === 'check' ? 'checked' : 'folded';
        }

        function logOpponentAction(action) {
            const board = gameState.board.filter(Boolean);
            if (!(board.length in STREET_NAMES)) {
                alert('Finish entering the 3 flop cards before logging an action after the flop.');
                return;
            }
            const opp = opponentReads[selectedOpp];
            if (opp.folded) {
                alert(`Opponent ${selectedOpp + 1} already folded. Click "New Hand" to start over.`);
                return;
            }
            const sized = action === 'raise' || action === 'call';
            const amount = sized ? (parseFloat(document.getElementById('oppBetInput').value) || 0) : 0;
            const entry = {
                action,
                street: STREET_NAMES[board.length],
                board: board.map(cardIndex),
                amount,
                betFrac: sized && gameState.pot > 0 ? amount / gameState.pot : 0
            };
            opp.actions.push(entry);
            if (action === 'fold') opp.folded = true;
            recomputeRange(opp);
            renderReads();
            if (gameState.hole[0] && gameState.hole[1]) {
                const when = entry.street === 'Preflop' ? 'preflop' : `on the ${entry.street.toLowerCase()}`;
                runMonteCarloSimulation(`Opp ${selectedOpp + 1} ${describeAction(entry)} ${when}`);
            }
        }

        function undoOpponentAction() {
            const opp = opponentReads[selectedOpp];
            if (!opp.actions.length) return;
            opp.actions.pop();
            opp.folded = opp.actions.some(a => a.action === 'fold');
            recomputeRange(opp);
            renderReads();
            if (gameState.hole[0] && gameState.hole[1]) {
                runMonteCarloSimulation(`Undid Opp ${selectedOpp + 1}'s last action`);
            }
        }

        function setOpponentType(type) {
            const opp = opponentReads[selectedOpp];
            opp.type = type;
            recomputeRange(opp);
            renderReads();
            if (opp.actions.length && gameState.hole[0] && gameState.hole[1]) {
                runMonteCarloSimulation(`Opp ${selectedOpp + 1} re-read as ${PLAYER_TYPES[type].label}`);
            }
        }

        function selectOpponent(i) {
            selectedOpp = i;
            renderReads();
        }

        // New hand: clear actions but remember who plays how
        function resetReads() {
            opponentReads = createOpponentReads(opponentReads.map(o => o.type));
            document.getElementById('readsUpdate').classList.add('hidden');
            renderReads();
        }

        function renderReads() {
            selectedOpp = Math.min(selectedOpp, gameState.opponents - 1);
            const opp = opponentReads[selectedOpp];

            // Opponent tabs
            document.getElementById('oppTabs').innerHTML = opponentReads.slice(0, gameState.opponents).map((o, i) => {
                const active = i === selectedOpp;
                const style = o.folded
                    ? 'bg-slate-950 text-slate-600 border-slate-800 line-through'
                    : active
                        ? 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40'
                        : 'bg-slate-800 text-slate-300 border-slate-700 hover:bg-slate-700';
                const count = o.actions.length ? ` <span class="opacity-60">· ${o.actions.length}</span>` : '';
                return `<button onclick="selectOpponent(${i})" class="px-2.5 py-1 rounded-lg text-xs font-semibold border transition ${style} ${active ? 'ring-1 ring-emerald-400/60' : ''}">Opp ${i + 1}${count}</button>`;
            }).join('');

            document.getElementById('oppTypeSelect').innerHTML = Object.entries(PLAYER_TYPES)
                .map(([key, t]) => `<option value="${key}" ${key === opp.type ? 'selected' : ''}>${t.label}</option>`)
                .join('');

            const boardCount = gameState.board.filter(Boolean).length;
            document.getElementById('streetLabel').innerText = STREET_NAMES[boardCount] || 'Finish the flop';

            // Action log
            document.getElementById('actionLog').innerHTML = opp.actions.length
                ? opp.actions.map(a => `<div class="flex gap-2"><span class="text-slate-500 w-12 shrink-0">${a.street}</span><span>${describeAction(a)}</span></div>`).join('')
                : '<span class="text-slate-500">No actions logged</span>';

            // 13x13 grid: pairs on the diagonal, suited above, offsuit below
            const summary = summarizeRange(opp);
            const avg = label => {
                const c = summary.classes[label];
                return c && c.combos ? c.weight / c.combos : 0;
            };
            const desc = RANKS.slice().reverse();
            let maxAvg = 0;
            Object.keys(summary.classes).forEach(label => { maxAvg = Math.max(maxAvg, avg(label)); });
            let cells = '';
            for (let i = 0; i < 13; i++) {
                for (let j = 0; j < 13; j++) {
                    const label = i === j ? desc[i] + desc[j] : i < j ? desc[i] + desc[j] + 's' : desc[j] + desc[i] + 'o';
                    const norm = maxAvg > 0 ? avg(label) / maxAvg : 0;
                    const share = summary.classes[label] ? summary.classes[label].weight : 0;
                    const shareTotal = Object.values(summary.classes).reduce((s, c) => s + c.weight, 0);
                    const pct = shareTotal > 0 ? share / shareTotal * 100 : 0;
                    cells += `<div title="${label}: ${pct.toFixed(1)}% of their range" class="aspect-square flex items-center justify-center text-[8px] md:text-[9px] font-mono font-semibold ${norm > 0.45 ? 'text-white' : 'text-slate-500'}" style="background: rgba(16, 185, 129, ${(0.06 + 0.94 * norm).toFixed(3)})">${label.slice(0, 2)}</div>`;
                }
            }
            document.getElementById('rangeGrid').innerHTML = cells;

            const hasReads = opp.actions.some(a => a.action !== 'fold');
            document.getElementById('rangeWidthLabel').innerText = opp.folded
                ? 'Folded'
                : hasReads ? `Narrowed to ≈${summary.widthPct.toFixed(0)}% of hands` : 'Any hand possible';
            document.getElementById('topHands').innerHTML = hasReads && !opp.folded
                ? summary.top.map(t => `<span class="px-2 py-0.5 rounded-md bg-emerald-500/15 border border-emerald-500/30 text-emerald-200 font-mono">${t.label} <span class="opacity-60">${t.share.toFixed(0)}%</span></span>`).join('')
                : opp.folded ? 'Out of the hand' : 'No reads yet';
        }

        function describeReadsForPrompt() {
            return opponentReads.slice(0, gameState.opponents).map((opp, i) => {
                const type = PLAYER_TYPES[opp.type].label;
                if (!opp.actions.length) return `- Opp ${i + 1} (${type}): no actions logged, any hand possible`;
                const acts = opp.actions.map(a => `${a.street}: ${describeAction(a)}`).join('; ');
                if (opp.folded) return `- Opp ${i + 1} (${type}): ${acts}. FOLDED, out of the hand`;
                const s = summarizeRange(opp);
                const top = s.top.map(t => `${t.label} (${t.share.toFixed(0)}%)`).join(', ');
                return `- Opp ${i + 1} (${type}): ${acts}. Estimated range ≈${s.widthPct.toFixed(0)}% of possible hands. Most likely: ${top}`;
            }).join('\n');
        }

        function runMonteCarloSimulation(trigger) {
            if (!gameState.hole[0] || !gameState.hole[1]) {
                alert('Please select both hole cards for your hand before running simulation.');
                return;
            }
            const activeOpps = getActiveOpponents();
            if (activeOpps.length === 0) {
                alert('Every opponent has folded, so you win the pot! Click "New Hand" in Opponent Reads to start over.');
                return;
            }

            const simBtn = document.getElementById('runSimBtn');
            simBtn.disabled = true;
            simBtn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i> Running 10,000 Monte Carlo Deals...`;

            // Timeout to allow UI to show spinning state
            setTimeout(() => {
                const iterations = 10000;
                const opponents = activeOpps.length;
                const readsActive = activeOpps.some(o => o.actions.length > 0);

                // Monte Carlo Loop (opponent hands weighted by Opponent Reads)
                const { wins, ties, losses } = simulateEquity(iterations, activeOpps.map(o => o.weights));

                // Compute final mathematical stats
                const winPct = (wins / iterations) * 100;
                const tiePct = (ties / iterations) * 100;
                const lossPct = (losses / iterations) * 100;

                // Pot Odds Calculation: Call / (Pot + Call)
                const pot = gameState.pot;
                const call = gameState.callAmount;
                const potOdds = call > 0 ? (call / (pot + call)) * 100 : 0;

                // Expected Value (EV): (Win Equity * Total Pot after Call) - Call
                const totalEquityFrac = (winPct + (tiePct / 2)) / 100;
                const expectedValue = call > 0 ? (totalEquityFrac * (pot + call)) - call : (totalEquityFrac * pot);

                // Recommendation Logic
                let action = "CHECK / CALL";
                let badgeClass = "bg-amber-500/20 text-amber-400 border-amber-500/30";

                if (call === 0) {
                    if (winPct > (100 / (opponents + 1)) + 15) {
                        action = "BET / RAISE";
                        badgeClass = "bg-emerald-500/20 text-emerald-400 border-emerald-500/30";
                    } else {
                        action = "CHECK";
                        badgeClass = "bg-blue-500/20 text-blue-400 border-blue-500/30";
                    }
                } else {
                    if (totalEquityFrac * 100 > potOdds + 12) {
                        action = "RAISE / RE-RAISE";
                        badgeClass = "bg-emerald-500/20 text-emerald-400 border-emerald-500/30";
                    } else if (totalEquityFrac * 100 >= potOdds) {
                        action = "CALL";
                        badgeClass = "bg-amber-500/20 text-amber-400 border-amber-500/30";
                    } else {
                        action = "FOLD";
                        badgeClass = "bg-rose-500/20 text-rose-400 border-rose-500/30";
                    }
                }

                // Compare against random hands so the coach can explain what the reads changed
                const equity = totalEquityFrac * 100;
                let baseline = equity;
                if (readsActive) baseline = baselineEquity(opponents);
                else baselineCache = { key: tableKey(opponents), equity };
                const prevEquity = gameState.lastSimResults ? gameState.lastSimResults.equity : null;

                gameState.lastSimResults = {
                    winPct, tiePct, lossPct, potOdds, expectedValue, action,
                    equity, baseline, readsActive, trigger: trigger || null
                };

                // Update UI Display
                document.getElementById('simResultsCard').classList.remove('hidden');
                document.getElementById('winRateVal').innerText = winPct.toFixed(1) + '%';
                document.getElementById('tieRateVal').innerText = tiePct.toFixed(1) + '%';
                document.getElementById('potOddsVal').innerText = potOdds.toFixed(1) + '%';
                document.getElementById('evVal').innerText = (expectedValue >= 0 ? '+' : '') + '$' + expectedValue.toFixed(2);
                document.getElementById('evVal').className = `text-xl font-black font-mono ${expectedValue >= 0 ? 'text-emerald-400' : 'text-rose-400'}`;

                const badge = document.getElementById('recommendedBadge');
                badge.innerText = action;
                badge.className = `px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider border ${badgeClass}`;

                // Update Distribution Bar
                document.getElementById('winBar').style.width = `${winPct}%`;
                document.getElementById('tieBar').style.width = `${tiePct}%`;
                document.getElementById('lossBar').style.width = `${lossPct}%`;
                document.getElementById('equityBreakdownLabel').innerText = `Win: ${winPct.toFixed(1)}% | Tie: ${tiePct.toFixed(1)}% | Loss: ${lossPct.toFixed(1)}%`;

                // Analysis text
                document.getElementById('simAnalysisText').innerHTML = `
                    <b>Mathematical Summary:</b> Your total equity is <b>${(totalEquityFrac*100).toFixed(1)}%</b> compared to required Pot Odds of <b>${potOdds.toFixed(1)}%</b>. 
                    This results in a long-term expected value of <b class="${expectedValue >= 0 ? 'text-emerald-400' : 'text-rose-400'}">${expectedValue >= 0 ? '+$' : '-$'}${Math.abs(expectedValue).toFixed(2)}</b> per decision.
                    ${readsActive ? `<br><br><b>Opponent Reads:</b> Against random hands you'd have <b>${baseline.toFixed(1)}%</b>. Based on how your opponents have acted, it's <b>${equity.toFixed(1)}%</b> (${equity >= baseline ? '▲' : '▼'} ${Math.abs(equity - baseline).toFixed(1)} pts).` : ''}
                `;
                document.getElementById('simSubtitle').innerText = readsActive
                    ? `Simulated ${iterations.toLocaleString()} deals, opponent hands weighted by your reads`
                    : `Simulated ${iterations.toLocaleString()} random card deals`;

                // Live update in the Opponent Reads panel
                const readsUpdate = document.getElementById('readsUpdate');
                if (trigger) {
                    const change = prevEquity === null ? '' : ` (${equity >= prevEquity ? '▲' : '▼'} ${Math.abs(equity - prevEquity).toFixed(1)} pts)`;
                    readsUpdate.innerHTML = `<b>${trigger}</b> → your equity is now <b>${equity.toFixed(1)}%</b>${change}. Recommended: <b>${action}</b>`;
                    readsUpdate.classList.remove('hidden');
                }

                simBtn.disabled = false;
                simBtn.innerHTML = `<i class="fa-solid fa-calculator"></i> Run Monte Carlo Simulation (10,000 Hands)`;

                // Auto notify Gemini chatbot with state context
                appendSystemMessageToChat();
            }, 50);
        }

        function appendSystemMessageToChat() {
            if (!gameState.lastSimResults) return;
            const res = gameState.lastSimResults;
            const holeText = gameState.hole.map(c => `${c.r}${SUIT_SYMBOLS[c.s]}`).join(' ');
            const boardText = gameState.board.filter(Boolean).map(c => `${c.r}${SUIT_SYMBOLS[c.s]}`).join(' ') || 'Pre-flop';

            const msgHtml = `
                <div class="bg-emerald-950/40 border border-emerald-500/30 p-2.5 rounded-xl text-xs text-emerald-200/90 my-2">
                    <b class="text-emerald-400"><i class="fa-solid fa-chart-line"></i> Simulation Loaded into AI Context:</b><br>
                    ${res.trigger ? `After: ${res.trigger}<br>` : ''}
                    Hand: [ ${holeText} ] | Board: [ ${boardText} ]<br>
                    Win Equity: ${res.winPct.toFixed(1)}% | EV: $${res.expectedValue.toFixed(2)} | Action: <b>${res.action}</b>
                    ${res.readsActive ? `<br>Reads: ${res.baseline.toFixed(1)}% vs random hands → ${res.equity.toFixed(1)}% vs their likely hands` : ''}
                </div>
            `;
            const chatBox = document.getElementById('chatMessages');
            chatBox.insertAdjacentHTML('beforeend', msgHtml);
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        function appendUserMessage(text) {
            const chatBox = document.getElementById('chatMessages');
            const msgHtml = `
                <div class="flex items-start gap-2.5 justify-end">
                    <div class="bg-emerald-600/20 border border-emerald-500/30 p-3 rounded-2xl rounded-tr-xs text-slate-100 max-w-[85%] text-xs leading-relaxed">
                        ${escapeHtml(text)}
                    </div>
                </div>
            `;
            chatBox.insertAdjacentHTML('beforeend', msgHtml);
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        function appendBotMessage(text) {
            const chatBox = document.getElementById('chatMessages');
            const msgHtml = `
                <div class="flex items-start gap-2.5">
                    <div class="w-7 h-7 rounded-full bg-emerald-600/30 text-emerald-400 border border-emerald-500/30 flex items-center justify-center text-xs shrink-0 mt-0.5">
                        <i class="fa-solid fa-robot"></i>
                    </div>
                    <div class="bg-slate-800 border border-slate-700/70 p-3 rounded-2xl rounded-tl-xs text-slate-300 max-w-[85%] text-xs leading-relaxed">
                        ${formatMarkdown(text)}
                    </div>
                </div>
            `;
            chatBox.insertAdjacentHTML('beforeend', msgHtml);
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        function escapeHtml(str) {
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }

        function formatMarkdown(text) {
            return text
                .replace(/\*\*(.*?)\*\*/g, '<b>$1</b>')
                .replace(/\*(.*?)\*/g, '<i>$1</i>')
                .replace(/\n/g, '<br>');
        }

        function sendQuickPrompt(text) {
            document.getElementById('chatInput').value = text;
            handleChatSubmit(new Event('submit'));
        }

        async function handleChatSubmit(e) {
            e.preventDefault();
            const input = document.getElementById('chatInput');
            const userText = input.value.trim();
            if (!userText) return;

            const apiKey = localStorage.getItem('gemini_api_key');
            if (!apiKey) {
                toggleKeyModal();
                alert('Please enter your Gemini API key to talk with the AI coach.');
                return;
            }

            appendUserMessage(userText);
            input.value = '';

            // Construct System Prompt and Context
            const holeText = gameState.hole[0] && gameState.hole[1] 
                ? `${gameState.hole[0].r}${gameState.hole[0].s} ${gameState.hole[1].r}${gameState.hole[1].s}`
                : 'None selected';
            
            const boardText = gameState.board.filter(Boolean).map(c => `${c.r}${c.s}`).join(' ') || 'Preflop (No board cards)';
            
            const simContext = gameState.lastSimResults ? `
                - Win Equity: ${gameState.lastSimResults.winPct.toFixed(1)}%
                - Tie Equity: ${gameState.lastSimResults.tiePct.toFixed(1)}%
                - Required Pot Odds: ${gameState.lastSimResults.potOdds.toFixed(1)}%
                - Expected Value (EV): $${gameState.lastSimResults.expectedValue.toFixed(2)}
                - Recommended Action: ${gameState.lastSimResults.action}
                - Equity vs random hands: ${gameState.lastSimResults.baseline.toFixed(1)}% / vs opponents' likely hands (from reads): ${gameState.lastSimResults.equity.toFixed(1)}%
            ` : 'Monte Carlo simulation not run yet.';

            const systemPrompt = `You are a world-class, friendly Texas Hold'em Poker Coach assisting a beginner player. 
            Translate raw math into concise, encouraging strategy explanations. Keep responses beginner-friendly, under 3 paragraphs, using bullet points for key tips.

            Current Table Context:
            - Player Hole Cards: ${holeText}
            - Community Board: ${boardText}
            - Active Opponents: ${gameState.opponents}
            - Current Pot: $${gameState.pot}
            - Amount to Call: $${gameState.callAmount}
            Monte Carlo Engine Stats:
            ${simContext}
            Opponent Reads (Bayesian range model built from each opponent's logged actions; the simulation deals opponents hands from these ranges):
            ${describeReadsForPrompt()}
            When opponents have logged actions, explain in plain language what their actions suggest they are holding and how that changed the player's equity.`;

            // Show typing indicator
            const chatBox = document.getElementById('chatMessages');
            const typingId = 'typing-' + Date.now();
            chatBox.insertAdjacentHTML('beforeend', `
                <div id="${typingId}" class="flex items-start gap-2.5">
                    <div class="w-7 h-7 rounded-full bg-emerald-600/30 text-emerald-400 border border-emerald-500/30 flex items-center justify-center text-xs shrink-0 mt-0.5">
                        <i class="fa-solid fa-robot"></i>
                    </div>
                    <div class="bg-slate-800 border border-slate-700/70 p-3 rounded-2xl text-slate-400 text-xs italic">
                        Gemini is analyzing Monte Carlo equity...
                    </div>
                </div>
            `);
            chatBox.scrollTop = chatBox.scrollHeight;

            try {
                // Call Gemini REST API
                const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;
                
                chatHistory.push({ role: 'user', parts: [{ text: userText }] });

                const payload = {
                    contents: [
                        { role: 'user', parts: [{ text: `System Context:\n${systemPrompt}\n\nUser Question: ${userText}` }] }
                    ]
                };

                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                document.getElementById(typingId)?.remove();

                if (!response.ok) {
                    throw new Error(`API returned HTTP ${response.status}`);
                }

                const result = await response.json();
                const aiReply = result.candidates?.[0]?.content?.parts?.[0]?.text || "I couldn't generate a strategy recommendation. Please try rephrasing.";

                appendBotMessage(aiReply);
                chatHistory.push({ role: 'model', parts: [{ text: aiReply }] });

            } catch (err) {
                document.getElementById(typingId)?.remove();
                appendBotMessage(`⚠️ **Error connecting to Gemini API**: ${err.message}. Please check that your API key is valid.`);
            }
        }

        function clearChatHistory() {
            chatHistory = [];
            document.getElementById('chatMessages').innerHTML = `
                <div class="flex items-start gap-2.5">
                    <div class="w-7 h-7 rounded-full bg-emerald-600/30 text-emerald-400 border border-emerald-500/30 flex items-center justify-center text-xs shrink-0 mt-0.5">
                        <i class="fa-solid fa-robot"></i>
                    </div>
                    <div class="bg-slate-800 border border-slate-700/70 p-3 rounded-2xl rounded-tl-xs text-slate-300 max-w-[85%] text-xs leading-relaxed">
                        Chat reset! Select cards on the table and ask me any Texas Hold'em question.
                    </div>
                </div>
            `;
        }
    </script>
</body>
</html>
